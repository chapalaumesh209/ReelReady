# Demo publishing is the default; only exact false permits real sending.
DEMO_MODE=true
APP_URL=http://127.0.0.1:3000

# Self-hosted publishing orchestration. Existing installs without this setting keep native execution.
# Run npm run n8n:setup locally to provision n8n and securely generate the bridge secret.
PUBLISH_EXECUTOR=n8n
# Managed account connections and video publishing through the n8n webhook workflows.
# Set native only for the retained direct-platform integration.
PUBLISH_PROVIDER=uploadpost
UPLOAD_POST_API_KEY=
# Production Space. Never use /webhook-test for deployed requests.
N8N_PROVIDER_WEBHOOK_BASE=https://umeshchapala-n8n.hf.space/webhook
# Local operator setup only; do not add the management key to Vercel or browser env.
N8N_API_KEY=
N8N_PUBLISHER_SECRET=
N8N_PUBLISHER_HOST=127.0.0.1
N8N_PUBLISHER_PORT=3010
# n8n has its own persistent encryption key in its separate .env.n8n.local/container secrets.
# It never needs Supabase service-role credentials or social access tokens.
# Managed publishing uses its own encrypted provider Header Auth credential in n8n.

# Supabase project. Browser variables are optional for future client-side account linking.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Configure one supported secret name, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SESSION_SECRET=

# Optional live text AI: gemini, openai, anthropic. Configured Gemini credentials take priority over legacy demo selection.
# Missing keys or failed attempts return actionable errors and preserve drafts.
# Canned fixtures are opt-in for isolated automated tests only.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# Existing optional video understanding and English speech.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional provider-specific key aliases.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional retained direct-platform OAuth, used only with PUBLISH_PROVIDER=native.
# Register APP_URL/api/connect/callback/{youtube,instagram,x} with each respective app.
# 32 random bytes encoded as base64; server and worker must share this stable key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=v24.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional server/worker media services. Missing keys never block opening the app.
SPEECH_TO_TEXT_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-3.5-transcribe
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
VIDEO_ANALYSIS_PROVIDER=gemini
# Native background compute, never a browser-visible setting.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_DURATION_SECONDS=1800
MEDIA_COMMAND_TIMEOUT_MS=600000
# Optional private temporary directory; defaults to OS temporary storage.
MEDIA_TEMP_DIR=

# Public-link guardrails (server variables; browser reads safe limits from /api/limits).
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=90
WORKER_HEARTBEAT_SECONDS=60
WORKER_POOL=default
MAX_ACTIVE_JOBS_PER_USER=2
# Total active queued/running work across all owners and worker pools.
MAX_QUEUED_JOBS=100
DAILY_PROVIDER_CALL_LIMIT=500
RETENTION_DAYS=7
# Owner limits per fixed one-hour window. IP limits multiply these to allow shared networks.
RATE_IP_MULTIPLIER=4
RATE_GENERATION_PER_HOUR=20
RATE_CHANGE_REQUEST_PER_HOUR=20
RATE_MEDIA_TRANSCRIBE_PER_HOUR=10
RATE_MEDIA_TRANSLATE_PER_HOUR=10
RATE_MEDIA_PREVIEW_PER_HOUR=10
RATE_MEDIA_GENERATE_PER_HOUR=10
RATE_MEDIA_SUGGEST_PER_HOUR=10
RATE_MEDIA_ANALYZE_PER_HOUR=10
RATE_MEDIA_RENDER_PER_HOUR=5
RATE_MEDIA_ENGLISH_PER_HOUR=5
RATE_UPLOAD_REGISTRATION_PER_HOUR=10
RATE_UPLOAD_PREPARE_PER_HOUR=10
RATE_CONNECT_PER_HOUR=10
RATE_PUBLISH_PER_HOUR=5
RATE_PUBLISH_PREPARE_PER_HOUR=10
RATE_PUBLISH_PREFLIGHT_PER_HOUR=30
RATE_VOICEOVER_PER_HOUR=10
# Real publishing requires exact DEMO_MODE=false, connected accounts, passing preflight
# and the creator's final confirmation. No publishing PIN is used.
# Default 48 hours, maximum seven days. Re-signed at send time; must outlive schedules.
PUBLISH_SIGNED_URL_TTL_SECONDS=172800

# Conservative editorial cap; adjust to your destination policy if needed.
INSTAGRAM_HASHTAG_LIMIT=5

# Never replace failed live AI calls with generic text. Enable only in isolated fixture environments.
ALLOW_SAMPLE_OUTPUT=false

# Hosted n8n fetches signed media directly from hosted Supabase, outside Vercel.
# Local Docker workflows use binary transport; hosted exports use url transport.
PUBLISH_MEDIA_TRANSPORT=url
