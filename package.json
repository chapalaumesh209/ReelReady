{
  "name": "reelready",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --env-file=.env.test.local --import tsx --import ./tests/provider-budget-isolation.mjs --test --test-concurrency=1 tests/api.test.ts tests/workflow.test.ts tests/captions.test.ts tests/hardening.test.ts tests/native-social.test.ts tests/n8n.test.ts tests/managed-publishing.test.ts tests/media-runtime.test.ts",
    "test:e2e": "node --env-file=.env.test.local node_modules/@playwright/test/cli.js test",
    "dev:sites": "node scripts/run-framework.mjs dev",
    "build:sites": "node scripts/run-framework.mjs build",
    "start:sites": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "setup:local": "node scripts/setup-local.mjs",
    "worker": "node --import tsx scripts/media-worker.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "test:media": "node --env-file=.env.test.local --import tsx --import ./tests/provider-budget-isolation.mjs --test tests/media.test.ts",
    "check:env": "node --import tsx scripts/check-env.ts",
    "cleanup": "node --import tsx scripts/cleanup.ts",
    "n8n:setup": "node scripts/setup-n8n.mjs",
    "n8n:start": "docker compose -f automation/n8n/compose.yaml up -d",
    "n8n:stop": "docker compose -f automation/n8n/compose.yaml stop",
    "verify:n8n": "node scripts/verify-provider-workflow.mjs",
    "verify:n8n:connect": "node scripts/verify-connect-workflow.mjs",
    "n8n:setup:hosted": "node --import tsx scripts/setup-hosted-n8n.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/server": "1.9.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tus-js-client": "^4.3.1",
    "twitter-text": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/twitter-text": "^3.1.10",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.122.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
