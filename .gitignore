# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Review artifacts and private runtime diagnostics
/artifacts/
/test-results/
/playwright-report/
/artifacts/*.png
/artifacts/*.json
!.env.example
/artifacts/*.wav
/artifacts/*.flac
/artifacts/*.log
/artifacts/*.mp4

/.next-offline/

/.next-test-studio/

# Local n8n bootstrap credentials; never commit.
/.n8n-local/

# Isolated production validation build
/.next-flow-build/

# Hosted n8n operation state and private workflow backups
/.n8n-hosted/
